{
  "name": "headless-lms",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @headless-lms/adapter-db db:generate",
    "db:migrate": "pnpm --filter @headless-lms/adapter-db db:migrate",
    "gen:sdk": "pnpm --filter @headless-lms/api gen:openapi && pnpm --filter @headless-lms/sdk gen && pnpm --filter @headless-lms/api gen:mcp-docs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "build:packages": "pnpm --filter './packages/*' --filter './adapters/*' --filter './plugins/*' -r build",
    "release": "pnpm build:packages && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "unrun": "^0.3.1",
    "vitest": "^2.1.8"
  }
}
