{
  "name": "@headless-lms/editor",
  "version": "0.1.0",
  "description": "Editor content contract (React-bound). The server never imports this.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19",
    "tsdown": "^0.22.9",
    "typescript": "^5.7.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdwt/headless-lms.git",
    "directory": "packages/editor"
  },
  "homepage": "https://github.com/mdwt/headless-lms#readme",
  "bugs": {
    "url": "https://github.com/mdwt/headless-lms/issues"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
