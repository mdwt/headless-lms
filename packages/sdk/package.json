{
  "name": "@headless-lms/sdk",
  "version": "0.3.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "gen": "openapi-ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.13.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "tsdown": "^0.22.9",
    "typescript": "^5.7.2"
  },
  "description": "Generated TypeScript SDK for the headless LMS API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdwt/headless-lms.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/mdwt/headless-lms#readme",
  "bugs": {
    "url": "https://github.com/mdwt/headless-lms/issues"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
